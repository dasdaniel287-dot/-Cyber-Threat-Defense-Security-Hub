        ];

        let currentQuestionIdx = 0;
        let userScore = 0;

        function initQuiz() {
            renderQuestion();
        }

        function renderQuestion() {
            const container = document.getElementById('quiz-container');
            const q = quizQuestions[currentQuestionIdx];

            if (currentQuestionIdx >= quizQuestions.length) {
                container.innerHTML = `
                    <div class="text-center py-8 space-y-4">
                        <i data-lucide="award" class="w-16 h-16 text-cyber-primary mx-auto"></i>
                        <h3 class="text-2xl font-bold text-white">Phishing Lab Completed!</h3>
                        <p class="text-slate-400 font-mono">Final Score: <strong class="text-cyber-success">${userScore} / ${quizQuestions.length}</strong></p>
                        <button onclick="resetQuiz()" class="px-6 py-2.5 bg-cyber-primary text-slate-950 font-bold rounded-xl text-sm">Retake Quiz</button>
                    </div>
                `;
                // Update Dashboard stats
                document.getElementById('stat-phishing-score').innerText = `${userScore} / ${quizQuestions.length}`;
                document.getElementById('stat-phishing-label').innerText = 'Verified IQ Score';
                document.getElementById('stat-phishing-bar').style.width = `${(userScore / quizQuestions.length) * 100}%`;
                lucide.createIcons();
                return;
            }

            container.innerHTML = `
                <div class="bg-slate-900/80 rounded-xl border border-slate-800 p-6 space-y-4 font-mono">
                    <div class="flex justify-between text-xs text-slate-500 border-b border-slate-800 pb-2">
                        <span>Email Sample #${currentQuestionIdx + 1} of ${quizQuestions.length}</span>
                        <span>Analyze Details Carefully</span>
                    </div>

                    <div class="space-y-1 text-xs text-slate-300">
                        <div><strong>From:</strong> <span class="text-cyber-warning">${escapeHTML(q.sender)}</span></div>
                        <div><strong>Subject:</strong> <span class="text-white">${escapeHTML(q.subject)}</span></div>
                    </div>

                    <div class="p-4 bg-slate-950 rounded-lg border border-slate-800 text-xs text-slate-300 leading-relaxed italic">
                        "${escapeHTML(q.body)}"
                    </div>

                    <div id="quiz-options" class="flex flex-col sm:flex-row gap-4 pt-4">
                        <button onclick="answerQuiz(true)" class="flex-1 py-3 bg-cyber-danger/10 hover:bg-cyber-danger/20 border border-cyber-danger/40 text-cyber-danger font-bold rounded-xl text-sm transition-all flex items-center justify-center space-x-2">
                            <i data-lucide="shield-alert" class="w-4 h-4"></i>
                            <span>Flag as Phishing Scam</span>
                        </button>
                        <button onclick="answerQuiz(false)" class="flex-1 py-3 bg-cyber-success/10 hover:bg-cyber-success/20 border border-cyber-success/40 text-cyber-success font-bold rounded-xl text-sm transition-all flex items-center justify-center space-x-2">
                            <i data-lucide="shield-check" class="w-4 h-4"></i>
                            <span>Legitimate Email</span>
                        </button>
                    </div>

                    <div id="quiz-feedback" class="hidden p-4 rounded-xl text-xs space-y-2 mt-4"></div>
                </div>
            `;
            lucide.createIcons();
        }

        function answerQuiz(userThinksPhishing) {
            const q = quizQuestions[currentQuestionIdx];
            const feedback = document.getElementById('quiz-feedback');
            const options = document.getElementById('quiz-options');
            
            options.classList.add('pointer-events-none', 'opacity-50');
            feedback.classList.remove('hidden');

            const isCorrect = userThinksPhishing === q.isPhishing;
            if (isCorrect) userScore++;

            document.getElementById('quiz-score').innerText = `${userScore} / ${quizQuestions.length}`;

            feedback.className = isCorrect ? 
                "p-4 rounded-xl border bg-cyber-success/10 border-cyber-success/40 text-cyber-success space-y-2 block" :
                "p-4 rounded-xl border bg-cyber-danger/10 border-cyber-danger/40 text-cyber-danger space-y-2 block";

            feedback.innerHTML = `
                <div class="font-bold text-sm flex items-center space-x-2">
                    <i data-lucide="${isCorrect ? 'check-circle' : 'x-circle'}" class="w-5 h-5"></i>
                    <span>${isCorrect ? 'Correct Analysis!' : 'Incorrect Assessment'}</span>
                </div>
                <p class="text-slate-300 leading-relaxed">${q.explanation}</p>
                <button onclick="nextQuestion()" class="mt-2 px-4 py-2 bg-slate-800 text-white rounded-lg text-xs font-bold hover:bg-slate-700">Next Scenario &rarr;</button>
            `;
            lucide.createIcons();
        }

        function nextQuestion() {
            currentQuestionIdx++;
            renderQuestion();
        }

        function resetQuiz() {
            currentQuestionIdx = 0;
            userScore = 0;
            document.getElementById('quiz-score').innerText = `0 / ${quizQuestions.length}`;
            renderQuestion();
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, 
                tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
            );
        }
    </script>
