        // Phishing Quiz Logic
        const quizQuestions = [
            {
                sender: "Security Alert <support@paypaI-security-update.com>",
                subject: "URGENT: Your Account Has Been Locked!",
                body: "Dear Customer, We detected an unauthorized login attempt from Russia. Click the link below immediately to verify your identity within 24 hours or your account will be suspended.",
                isPhishing: true,
                explanation: "Phishing! Notice the sneaky typosquatted domain 'paypaI' (with a capital 'I' instead of 'l') and the artificial sense of extreme urgency."
            },
            {
                sender: "GitHub <noreply@github.com>",
                subject: "[GitHub] Security advisory notification",
                body: "A new security vulnerability was reported in a repository you contribute to. Please review the advisory details directly in your repository settings dashboard.",
                isPhishing: false,
                explanation: "Legitimate email! The sender domain is official (@github.com) and it instructs you to navigate directly to your own dashboard rather than urging a suspicious external click."
