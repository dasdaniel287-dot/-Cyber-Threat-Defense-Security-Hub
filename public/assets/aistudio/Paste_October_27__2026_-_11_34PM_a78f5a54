        // Network Diagnostics Functionality
        function runNetworkDiagnostics() {
            const consoleOut = document.getElementById('net-console-output');
            consoleOut.innerHTML = `<div>[0.00s] Refreshing active socket diagnostics...</div>`;
            
            setTimeout(() => {
                consoleOut.innerHTML += `<div>[0.15s] Testing TLS handshake cipher speed ... <span class="text-cyber-success font-bold">OPTIMAL (12ms)</span></div>`;
                consoleOut.innerHTML += `<div>[0.30s] Verifying DNSSEC Signature integrity ... <span class="text-cyber-success font-bold">PASSED</span></div>`;
                consoleOut.innerHTML += `<div>[0.45s] Checking IPv6 fallback tunneling ... <span class="text-cyber-primary">SECURE</span></div>`;
