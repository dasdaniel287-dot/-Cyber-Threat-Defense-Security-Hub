                    </div>
                `;
            } else {
                resultCard.className = "mt-8 p-6 rounded-xl border border-cyber-success/40 bg-cyber-success/5 space-y-4";
                resultCard.innerHTML = `
                    <div class="flex items-center space-x-3 text-cyber-success">
                        <i data-lucide="shield-check" class="w-7 h-7"></i>
                        <div>
                            <h3 class="font-bold text-lg text-white">Target Clean & Verified</h3>
                            <p class="text-xs font-mono text-cyber-success">No malicious signatures or anomalies detected</p>
                        </div>
                    </div>
                    <div class="bg-slate-900/80 p-4 rounded-lg font-mono text-xs space-y-2 border border-slate-800">
                        <div class="text-slate-300">Target Analyzed: <span class="text-white">${target}</span></div>
                        <div class="text-slate-300">Scanner Engine Hits: <span class="text-cyber-success font-bold">0 / 68 Flagged (Clean)</span></div>
                        <div class="text-slate-300">SSL Certificate: <span class="text-cyber-success">Valid (Issued by Trusted CA)</span></div>
                    </div>
                `;
            }
            lucide.createIcons();
        }

        // Password Strength & Entropy Logic
        function togglePassVisibility() {
            const input = document.getElementById('pass-input');
            const icon = document.getElementById('pass-toggle-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.setAttribute('data-lucide', 'eye-off');
            } else {
                input.type = 'password';
                icon.setAttribute('data-lucide', 'eye');
            }
            lucide.createIcons();
        }

        function analyzePassword() {
            const pass = document.getElementById('pass-input').value;
            const bar = document.getElementById('pass-strength-bar');
            const label = document.getElementById('pass-score-label');
            const crackTime = document.getElementById('crack-time');
            const entropyEl = document.getElementById('pass-entropy');
            const lengthEl = document.getElementById('pass-length');

            lengthEl.innerText = `${pass.length} chars`;

            // Rules
            const hasLen = pass.length >= 12;
            const hasNum = /\d/.test(pass);
            const hasSym = /[^a-zA-Z0-9]/.test(pass);
            const hasCase = /[a-z]/.test(pass) && /[A-Z]/.test(pass);

            updateRuleIcon('rule-len', hasLen);
            updateRuleIcon('rule-num', hasNum);
            updateRuleIcon('rule-sym', hasSym);
            updateRuleIcon('rule-case', hasCase);

            if (!pass) {
                bar.style.width = '0%';
                label.innerText = 'EMPTY';
                label.className = 'text-slate-500 font-bold';
                crackTime.innerText = 'Instant';
                entropyEl.innerText = '0 bits';
                return;
            }

            // Calculate Entropy
            let poolSize = 0;
            if (/[a-z]/.test(pass)) poolSize += 26;
            if (/[A-Z]/.test(pass)) poolSize += 26;
            if (/\d/.test(pass)) poolSize += 10;
            if (/[^a-zA-Z0-9]/.test(pass)) poolSize += 32;

            const entropy = Math.floor(pass.length * Math.log2(poolSize || 1));
            entropyEl.innerText = `${entropy} bits`;

            // Score evaluation
            let score = 0;
            if (pass.length > 6) score += 20;
            if (pass.length >= 12) score += 30;
            if (hasNum) score += 15;
            if (hasSym) score += 20;
            if (hasCase) score += 15;

            bar.style.width = `${Math.min(score, 100)}%`;

            if (score < 40) {
                label.innerText = 'WEAK';
                label.className = 'text-cyber-danger font-bold';
                bar.className = 'h-full rounded-full transition-all duration-300 bg-cyber-danger';
                crackTime.innerText = '< 5 Seconds';
            } else if (score < 75) {
                label.innerText = 'MODERATE';
                label.className = 'text-cyber-warning font-bold';
                bar.className = 'h-full rounded-full transition-all duration-300 bg-cyber-warning';
                crackTime.innerText = '3 Weeks';
            } else {
                label.innerText = 'CRYPTO-STRONG';
                label.className = 'text-cyber-success font-bold';
                bar.className = 'h-full rounded-full transition-all duration-300 bg-cyber-success';
                crackTime.innerText = '4,000+ Years';
            }
        }

        function updateRuleIcon(elementId, isValid) {
            const el = document.getElementById(elementId);
            if (isValid) {
                el.className = 'flex items-center space-x-2 text-cyber-success';
                el.children[0].setAttribute('data-lucide', 'circle-check');
            } else {
                el.className = 'flex items-center space-x-2 text-slate-500';
                el.children[0].setAttribute('data-lucide', 'circle-x');
            }
            lucide.createIcons();
        }

        function generateStrongPassword() {
            const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+-=";
            let pass = "";
            for (let i = 0; i < 16; i++) {
                pass += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            const input = document.getElementById('pass-input');
            input.value = pass;
            input.type = 'text';
            analyzePassword();
        }

        function checkDataBreach() {
            const email = document.getElementById('breach-email').value.trim();
            const resBox = document.getElementById('breach-result font-mono');
            if (!email) return;

            resBox.classList.remove('hidden');
            resBox.className = "p-4 rounded-xl border bg-slate-900 border-slate-800 text-slate-300 text-xs space-y-2";
            resBox.innerText = "Querying dark web breach databases...";

            setTimeout(() => {
                if (email.includes('test') || email.includes('admin') || email.includes('pwned')) {
                    resBox.className = "p-4 rounded-xl border bg-cyber-danger/10 border-cyber-danger/40 text-cyber-danger text-xs space-y-2";
                    resBox.innerHTML = `
                        <div class="font-bold flex items-center space-x-2">
                            <i data-lucide="alert-circle" class="w-4 h-4"></i>
