        function runURLScan() {
            const target = document.getElementById('scanner-url-input').value.trim();
            if (!target) return;

            executeScanSimulation(target, 'URL Target');
        }

        function runFileScan() {
            const fileName = document.getElementById('file-name').innerText || 'Uploaded_Sample.bin';
            executeScanSimulation(fileName, 'File Payload');
