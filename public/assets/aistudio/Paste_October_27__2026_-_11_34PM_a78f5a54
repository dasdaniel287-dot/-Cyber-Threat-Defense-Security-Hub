<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AegisShield | Cyber Threat Defense & Security Hub</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            bg: '#0a0d14',
                            card: '#111625',
                            border: '#1e293b',
                            primary: '#00f0ff',
                            secondary: '#7000ff',
                            success: '#00ff88',
                            warning: '#ffb700',
                            danger: '#ff0055'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0a0d14;
            color: #e2e8f0;
            overflow-x: hidden;
        }
        .cyber-glow {
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
        }
        .cyber-glow-purple {
            box-shadow: 0 0 15px rgba(112, 0, 255, 0.25);
        }
        .cyber-border-glow:focus-within {
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
            border-color: #00f0ff;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0d14;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00f0ff;
        }
        .glass-panel {
            background: rgba(17, 22, 37, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        @keyframes pulse-scan {
            0% { top: 0%; opacity: 0.8; }
            50% { opacity: 0.3; }
            100% { top: 100%; opacity: 0.8; }
        }
        .scanner-line {
            position: absolute;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, #00f0ff, transparent);
            animation: pulse-scan 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyber-secondary to-cyber-primary flex items-center justify-center text-slate-950 font-bold shadow-lg shadow-cyber-primary/20">
                        <i data-lucide="shield-check" class="w-6 h-6 stroke-[2.5]"></i>
                    </div>
                    <div>
                        <span class="text-xl font-bold bg-gradient-to-r from-white via-slate-200 to-cyber-primary bg-clip-text text-transparent tracking-tight">AegisShield</span>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-cyber-primary/10 text-cyber-primary border border-cyber-primary/20 ml-2 font-mono">v3.4 SECURE</span>
                    </div>
                </div>

                <!-- Navigation Links -->
                <nav class="hidden md:flex items-center space-x-1">
                    <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium transition-all text-cyber-primary bg-cyber-primary/10 border border-cyber-primary/30 flex items-center space-x-2">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                        <span>Dashboard</span>
                    </button>
                    <button onclick="switchTab('scanner')" id="nav-scanner" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all flex items-center space-x-2">
                        <i data-lucide="radar" class="w-4 h-4"></i>
                        <span>Threat Scanner</span>
                    </button>
                    <button onclick="switchTab('password')" id="nav-password" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all flex items-center space-x-2">
                        <i data-lucide="key-round" class="w-4 h-4"></i>
                        <span>Password & Breach</span>
                    </button>
                    <button onclick="switchTab('network')" id="nav-network" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all flex items-center space-x-2">
                        <i data-lucide="wifi" class="w-4 h-4"></i>
                        <span>Network Audit</span>
                    </button>
                    <button onclick="switchTab('phishing')" id="nav-phishing" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all flex items-center space-x-2">
                        <i data-lucide="fish-off" class="w-4 h-4"></i>
                        <span>Phishing Lab</span>
                    </button>
                    <button onclick="switchTab('tips')" id="nav-tips" class="nav-btn px-4 py-2 rounded-lg text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all flex items-center space-x-2">
                        <i data-lucide="book-open" class="w-4 h-4"></i>
                        <span>Defense Vault</span>
                    </button>
                </nav>

                <!-- Quick Action Status -->
                <div class="hidden sm:flex items-center space-x-3">
                    <div class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs">
                        <span class="w-2 h-2 rounded-full bg-cyber-success animate-ping"></span>
                        <span class="text-slate-300 font-mono">Realtime Shield: <strong class="text-cyber-success">ACTIVE</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- TAB 1: DASHBOARD -->
        <section id="tab-dashboard" class="tab-content space-y-6">
            <!-- Hero Banner -->
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 via-cyber-card to-slate-900 border border-slate-800 p-6 sm:p-8">
                <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-cyber-primary/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute right-40 -top-20 w-64 h-64 bg-cyber-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div class="space-y-3">
                        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-md bg-cyber-primary/10 border border-cyber-primary/30 text-cyber-primary text-xs font-mono">
                            <i data-lucide="shield-alert" class="w-3.5 h-3.5"></i>
                            <span>SYSTEM SECURITY INDEX STATUS</span>
                        </div>
                        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                            Digital Perimeter: <span class="text-cyber-success">PROTECTED</span>
                        </h1>
                        <p class="text-slate-400 max-w-2xl text-sm sm:text-base">
                            Real-time intelligence feed active. Monitor zero-day vulnerabilities, audit device posture, analyze links, and simulate data leak scans in one central cyber operations center.
                        </p>
                    </div>
                    <div class="flex items-center gap-4 bg-slate-950/60 p-4 rounded-xl border border-slate-800/80">
                        <div class="text-center">
                            <span class="text-xs text-slate-400 uppercase font-mono block">Threat Score</span>
                            <span class="text-3xl font-bold font-mono text-cyber-success">98.4<span class="text-xs text-slate-500">/100</span></span>
                        </div>
                        <div class="h-10 w-px bg-slate-800"></div>
                        <button onclick="switchTab('scanner')" class="px-4 py-2 bg-gradient-to-r from-cyber-primary to-blue-600 text-slate-950 font-semibold rounded-lg hover:brightness-110 transition-all text-sm flex items-center space-x-2 shadow-lg shadow-cyber-primary/20">
                            <i data-lucide="zap" class="w-4 h-4 fill-slate-950"></i>
                            <span>Run Full Audit</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Key Security Metrics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-cyber-card p-5 rounded-xl border border-slate-800 hover:border-slate-700 transition-all">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 text-sm font-medium">URLs & Files Scanned</span>
                        <div class="p-2 rounded-lg bg-cyber-primary/10 text-cyber-primary">
                            <i data-lucide="search-code" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="text-2xl font-bold font-mono text-white" id="stat-scans">1,429</span>
                        <span class="text-xs font-mono text-cyber-success flex items-center"><i data-lucide="trending-up" class="w-3 h-3 mr-1"></i> +12% today</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
                        <div class="bg-cyber-primary h-full w-3/4"></div>
                    </div>
                </div>

                <div class="bg-cyber-card p-5 rounded-xl border border-slate-800 hover:border-slate-700 transition-all">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 text-sm font-medium">Blocked Cyber Threats</span>
                        <div class="p-2 rounded-lg bg-cyber-danger/10 text-cyber-danger">
                            <i data-lucide="shield-x" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="text-2xl font-bold font-mono text-white">48</span>
                        <span class="text-xs font-mono text-cyber-danger flex items-center"><i data-lucide="alert-triangle" class="w-3 h-3 mr-1"></i> 3 High Risk</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
                        <div class="bg-cyber-danger h-full w-1/4"></div>
                    </div>
                </div>

                <div class="bg-cyber-card p-5 rounded-xl border border-slate-800 hover:border-slate-700 transition-all">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 text-sm font-medium">Network Protocol Status</span>
                        <div class="p-2 rounded-lg bg-cyber-success/10 text-cyber-success">
                            <i data-lucide="lock" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="text-2xl font-bold font-mono text-cyber-success">HTTPS / TLS 1.3</span>
                        <span class="text-xs font-mono text-slate-400">Encrypted</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
                        <div class="bg-cyber-success h-full w-full"></div>
                    </div>
                </div>

                <div class="bg-cyber-card p-5 rounded-xl border border-slate-800 hover:border-slate-700 transition-all">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 text-sm font-medium">Phishing IQ Score</span>
                        <div class="p-2 rounded-lg bg-cyber-secondary/10 text-cyber-secondary">
                            <i data-lucide="brain-circuit" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="mt-4 flex items-baseline justify-between">
                        <span class="text-2xl font-bold font-mono text-white" id="stat-phishing-score">-- / 5</span>
                        <span class="text-xs font-mono text-slate-400" id="stat-phishing-label">Quiz pending</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
                        <div id="stat-phishing-bar" class="bg-cyber-secondary h-full w-0 transition-all duration-500"></div>
                    </div>
                </div>
            </div>

            <!-- Quick Utilities Overview Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Live Security Alerts Widget -->
                <div class="lg:col-span-2 bg-cyber-card rounded-2xl border border-slate-800 p-6 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="rss" class="w-5 h-5 text-cyber-primary"></i>
                                <h2 class="text-lg font-bold text-white">Global Cyber Threat Feed (Simulated Realtime)</h2>
                            </div>
                            <span class="text-xs font-mono text-slate-400 bg-slate-900 px-2.5 py-1 rounded border border-slate-800">LIVE MONITORING</span>
                        </div>
                        <div class="space-y-3" id="live-threat-feed">
                            <!-- Populated dynamically via JS -->
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-slate-800 flex justify-between items-center text-xs text-slate-400 font-mono">
                        <span>Updating via Aegis Threat Intelligence API</span>
                        <button onclick="refreshThreatFeed()" class="text-cyber-primary hover:underline flex items-center space-x-1">
                            <i data-lucide="refresh-cw" class="w-3 h-3"></i>
                            <span>Refresh Feed</span>
                        </button>
                    </div>
                </div>

                <!-- Quick Check Panel -->
                <div class="bg-cyber-card rounded-2xl border border-slate-800 p-6 flex flex-col">
                    <h2 class="text-lg font-bold text-white mb-2">Instant URL Quick-Check</h2>
                    <p class="text-xs text-slate-400 mb-4">Verify link safety before clicking or sharing external domain links.</p>
                    
                    <div class="space-y-4 flex-grow flex flex-col justify-center">
                        <div class="relative">
                            <input type="text" id="dash-quick-url" placeholder="https://example-domain.com" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyber-primary transition-all font-mono">
                        </div>
                        <button onclick="quickScanURL()" class="w-full py-3 bg-cyber-primary/10 hover:bg-cyber-primary/20 border border-cyber-primary/40 text-cyber-primary font-semibold rounded-xl text-sm transition-all flex items-center justify-center space-x-2">
                            <i data-lucide="shield-search" class="w-4 h-4"></i>
                            <span>Analyze URL</span>
                        </button>
                        <div id="quick-url-result" class="hidden p-3 rounded-lg text-xs font-mono border"></div>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-800">
                        <div class="flex items-center justify-between text-xs text-slate-400">
                            <span>Browser Protection: <strong class="text-cyber-success">Enabled</strong></span>
                            <span class="text-cyber-primary cursor-pointer hover:underline" onclick="switchTab('scanner')">Advanced Scanner &rarr;</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: URL & FILE SAFETY SCANNER -->
        <section id="tab-scanner" class="tab-content hidden space-y-6">
            <div class="bg-cyber-card rounded-2xl border border-slate-800 p-6 sm:p-8">
                <div class="max-w-3xl">
                    <span class="text-xs font-mono text-cyber-primary uppercase tracking-wider">Multi-Engine Security Scanner</span>
                    <h2 class="text-2xl font-bold text-white mt-1">URL & File Threat Diagnostics</h2>
                    <p class="text-slate-400 text-sm mt-1">Simulate deep heuristic scans, SSL certification checks, malware signatures, and reputation analysis across multiple antimalware engines.</p>
                </div>

                <!-- Toggle Selector -->
                <div class="flex border-b border-slate-800 mt-6 mb-6">
                    <button id="scan-mode-url-btn" onclick="toggleScanMode('url')" class="pb-3 px-4 text-sm font-semibold border-b-2 border-cyber-primary text-cyber-primary flex items-center space-x-2">
                        <i data-lucide="link" class="w-4 h-4"></i>
                        <span>Scan URL / Web Domain</span>
                    </button>
                    <button id="scan-mode-file-btn" onclick="toggleScanMode('file')" class="pb-3 px-4 text-sm font-semibold border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center space-x-2">
                        <i data-lucide="file-up" class="w-4 h-4"></i>
                        <span>Scan Local File</span>
                    </button>
                </div>

                <!-- URL Scan Form -->
                <div id="scanner-url-panel" class="space-y-4">
                    <label class="block text-xs font-mono text-slate-400">ENTER DOMAIN OR FULL TARGET URL</label>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <input type="text" id="scanner-url-input" placeholder="e.g. https://secure-login-bank-verify.xyz/login" class="flex-grow bg-slate-900 border border-slate-700 rounded-xl px-4 py-3.5 text-sm text-white focus:outline-none focus:border-cyber-primary font-mono transition-all">
                        <button onclick="runURLScan()" class="px-6 py-3.5 bg-cyber-primary hover:bg-cyan-400 text-slate-950 font-bold rounded-xl text-sm transition-all flex items-center justify-center space-x-2 shadow-lg shadow-cyber-primary/20">
                            <i data-lucide="scan" class="w-4 h-4"></i>
                            <span>Scan Target</span>
                        </button>
                    </div>
                    <div class="flex flex-wrap gap-2 pt-2">
                        <span class="text-xs text-slate-500">Test presets:</span>
                        <button onclick="presetURL('https://google.com')" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-2 py-1 rounded font-mono">Safe Domain</button>
                        <button onclick="presetURL('http://free-crypto-giveaway-winner.xyz/login')" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-2 py-1 rounded font-mono">Suspicious Phishing</button>
                        <button onclick="presetURL('http://malware-download-drop.temp-site.net/payload.exe')" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-2 py-1 rounded font-mono">Malware Drop</button>
                    </div>
                </div>

                <!-- File Scan Form (Hidden by default) -->
                <div id="scanner-file-panel" class="hidden space-y-4">
                    <label class="block text-xs font-mono text-slate-400">UPLOAD OR DRAG FILE FOR HEURISTIC AUDIT</label>
                    <div id="drop-zone" class="border-2 border-dashed border-slate-700 hover:border-cyber-primary rounded-2xl p-8 text-center bg-slate-900/50 cursor-pointer transition-all">
                        <i data-lucide="cloud-upload" class="w-10 h-10 text-slate-500 mx-auto mb-3"></i>
                        <p class="text-sm font-semibold text-slate-300">Click to upload file or drag & drop</p>
                        <p class="text-xs text-slate-500 mt-1">Supports EXE, ZIP, PDF, DOCX, APK (Max 100MB simulation)</p>
                        <input type="file" id="file-input" class="hidden" onchange="handleFileSelect(event)">
                    </div>
                    <div id="file-info" class="hidden bg-slate-900 p-3 rounded-lg border border-slate-800 flex justify-between items-center text-sm">
                        <div class="flex items-center space-x-3">
                            <i data-lucide="file text-cyber-primary" class="w-5 h-5"></i>
                            <div>
                                <p id="file-name" class="font-mono text-white text-xs"></p>
                                <p id="file-size" class="text-xs text-slate-500 font-mono"></p>
                            </div>
                        </div>
                        <button onclick="runFileScan()" class="px-4 py-2 bg-cyber-primary text-slate-950 font-bold rounded-lg text-xs hover:bg-cyan-400">Scan File</button>
                    </div>
                </div>

                <!-- Scan Progress Bar Simulation -->
                <div id="scan-progress-box" class="hidden mt-8 space-y-3 bg-slate-900/80 p-6 rounded-xl border border-slate-800 relative overflow-hidden">
                    <div class="scanner-line"></div>
                    <div class="flex justify-between items-center text-sm font-mono">
                        <span class="text-cyber-primary flex items-center space-x-2">
                            <i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i>
                            <span id="scan-status-text">Initializing scanning engines...</span>
                        </span>
                        <span class="text-slate-400" id="scan-percent font-bold">0%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                        <div id="scan-progress-bar" class="bg-gradient-to-r from-cyber-primary to-cyber-secondary h-full w-0 transition-all duration-300"></div>
                    </div>
                    <div class="text-xs font-mono text-slate-500 grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2" id="engine-status-list">
                        <div>SSL Audit: <span class="text-slate-400">Pending</span></div>
                        <div>Blacklist Check: <span class="text-slate-400">Pending</span></div>
                        <div>Heuristics: <span class="text-slate-400">Pending</span></div>
                        <div>Sandbox Test: <span class="text-slate-400">Pending</span></div>
                    </div>
                </div>

                <!-- Scan Results Container -->
                <div id="scan-result-card" class="hidden mt-8 p-6 rounded-xl border space-y-4">
                    <!-- Populated dynamically -->
                </div>
            </div>
        </section>

        <!-- TAB 3: PASSWORD STRENGTH & BREACH CHECKER -->
        <section id="tab-password" class="tab-content hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Left: Password Strength Evaluator -->
                <div class="lg:col-span-7 bg-cyber-card rounded-2xl border border-slate-800 p-6 sm:p-8 space-y-6">
                    <div>
                        <span class="text-xs font-mono text-cyber-primary uppercase">Cryptographic Audit</span>
                        <h2 class="text-2xl font-bold text-white mt-1">Password Strength & Entropy Analyzer</h2>
                        <p class="text-slate-400 text-sm mt-1">Check crack resistance time against GPU cluster dictionary and brute-force attacks.</p>
                    </div>

                    <div class="space-y-4">
                        <div class="relative">
                            <input type="password" id="pass-input" oninput="analyzePassword()" placeholder="Enter test password..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3.5 pr-12 text-sm text-white font-mono focus:outline-none focus:border-cyber-primary transition-all">
                            <button onclick="togglePassVisibility()" class="absolute right-3 top-3.5 text-slate-400 hover:text-white">
                                <i data-lucide="eye" id="pass-toggle-icon" class="w-5 h-5"></i>
                            </button>
                        </div>

                        <!-- Password Quality Gauge Bar -->
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs font-mono">
                                <span class="text-slate-400">SECURITY SCORE</span>
                                <span id="pass-score-label" class="text-slate-500 font-bold">EMPTY</span>
                            </div>
                            <div class="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden p-0.5 border border-slate-800">
                                <div id="pass-strength-bar" class="h-full rounded-full w-0 transition-all duration-300 bg-slate-700"></div>
                            </div>
