        function executeScanSimulation(targetName, scanType) {
            const progressBox = document.getElementById('scan-progress-box');
            const progressBar = document.getElementById('scan-progress-bar');
            const statusText = document.getElementById('scan-status-text');
            const resultCard = document.getElementById('scan-result-card');

            progressBox.classList.remove('hidden');
            resultCard.classList.add('hidden');
            progressBar.style.width = '0%';

            let percent = 0;
            const interval = setInterval(() => {
                percent += 20;
                progressBar.style.width = `${percent}%`;

                if (percent === 40) statusText.innerText = 'Querying global threat intelligence databases...';
                if (percent === 70) statusText.innerText = 'Executing heuristic malware signature analysis...';
                if (percent === 90) statusText.innerText = 'Finalizing diagnostic report...';

                if (percent >= 100) {
                    clearInterval(interval);
                    progressBox.classList.add('hidden');
                    renderScanResults(targetName, scanType);
                }
            }, 300);
        }

