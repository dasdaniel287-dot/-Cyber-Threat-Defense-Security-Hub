            {
                sender: "IT Helpdesk <admin-support-desk@internal-corp-portal.xyz>",
                subject: "Mandatory Password Reset Required",
                body: "Attention Staff, Our IT department is upgrading all company databases today. Please submit your current username and password in this form to avoid locked access.",
